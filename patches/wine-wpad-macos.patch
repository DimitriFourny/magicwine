From: MagicWine contributors
Subject: [PATCH] winhttp: Respect macOS host proxy autodiscovery policy

Read SystemConfiguration on every discovery call, before the WPAD cache.
A disabled or absent host setting returns the normal autodetection-failed
result; enabled, unreadable, malformed and non-macOS policies retain Wine
discovery. Explicit PAC evaluation and invalid-argument handling are unchanged.
The pointer-free Unix-call parameters have identical native/WOW64 layouts.

Based on Wine 11.0. New source is LGPL-2.1-or-later, like WinHTTP.

diff --git a/dlls/winhttp/Makefile.in b/dlls/winhttp/Makefile.in
--- a/dlls/winhttp/Makefile.in
+++ b/dlls/winhttp/Makefile.in
@@ -1,8 +1,10 @@
 EXTRADEFS = -D_WINHTTP_INTERNAL_
 MODULE    = winhttp.dll
+UNIXLIB   = winhttp.so
 IMPORTLIB = winhttp
 IMPORTS   = uuid jsproxy user32 advapi32 ws2_32
 DELAYIMPORTS = oleaut32 crypt32 secur32 iphlpapi dhcpcsvc
+UNIX_LIBS = $(SYSTEMCONFIGURATION_LIBS) $(COREFOUNDATION_LIBS)
 
 SOURCES = \
 	cookie.c \
@@ -12,5 +14,6 @@
 	request.c \
 	rsrc.rc \
 	session.c \
+	unixlib.c \
 	url.c \
 	winhttp_tlb.idl
diff --git a/dlls/winhttp/main.c b/dlls/winhttp/main.c
--- a/dlls/winhttp/main.c
+++ b/dlls/winhttp/main.c
@@ -29,6 +29,7 @@
 
 #include "wine/debug.h"
 #include "winhttp_private.h"
+#include "unixlib.h"
 
 HINSTANCE winhttp_instance;
 
@@ -44,6 +45,8 @@
     case DLL_PROCESS_ATTACH:
         winhttp_instance = hInstDLL;
         DisableThreadLibraryCalls(hInstDLL);
+        if (__wine_init_unix_call())
+            WARN( "Host proxy autodiscovery policy unavailable\n" );
         break;
     case DLL_PROCESS_DETACH:
         if (lpv) break;
diff --git a/dlls/winhttp/session.c b/dlls/winhttp/session.c
--- a/dlls/winhttp/session.c
+++ b/dlls/winhttp/session.c
@@ -35,6 +35,7 @@
 
 #include "wine/debug.h"
 #include "winhttp_private.h"
+#include "unixlib.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(winhttp);
 
@@ -1672,6 +1673,7 @@
     static HANDLE notifyaddr_handle = INVALID_HANDLE_VALUE;
     static OVERLAPPED notifyaddr_ol;
     DWORD bytes;
+    struct proxy_autodiscovery_params params = { TRUE };
 
     TRACE( "%#lx, %p\n", flags, url );
 
@@ -1681,6 +1683,14 @@
         return FALSE;
     }
     *url = NULL;
+
+    /* Consult the host on every call, before reusing any cached WPAD URL. */
+    if (__wine_unixlib_handle &&
+        !WINE_UNIX_CALL( unix_get_proxy_autodiscovery, &params ) && !params.enabled)
+    {
+        SetLastError( ERROR_WINHTTP_AUTODETECTION_FAILED );
+        return FALSE;
+    }
 
     AcquireSRWLockExclusive( &apc_cache_lock );
     /* FIXME: use NotifyIpInterfaceChange once that's implemented */
diff --git a/dlls/winhttp/unixlib.c b/dlls/winhttp/unixlib.c
new file mode 100644
--- /dev/null
+++ b/dlls/winhttp/unixlib.c
@@ -0,0 +1,85 @@
