+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#ifdef __APPLE__
+#include <SystemConfiguration/SystemConfiguration.h>
+#endif
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "unixlib.h"
+
+static NTSTATUS get_proxy_autodiscovery( void *args )
+{
+    struct proxy_autodiscovery_params *params = args;
+
+    /* An unavailable or malformed host policy must not disable discovery. */
+    params->enabled = TRUE;
+#ifdef __APPLE__
+    {
+        CFDictionaryRef proxies;
+        CFTypeRef value;
+        int enabled = 0;
+        NTSTATUS status = STATUS_SUCCESS;
+
+        if (!(proxies = SCDynamicStoreCopyProxies( NULL ))) return STATUS_NOT_SUPPORTED;
+        value = CFDictionaryGetValue( proxies, kSCPropNetProxiesProxyAutoDiscoveryEnable );
+        if (!value)
+            params->enabled = FALSE;
+        else if (CFGetTypeID( value ) == CFBooleanGetTypeID())
+            params->enabled = CFBooleanGetValue( value );
+        else if (CFGetTypeID( value ) == CFNumberGetTypeID() &&
+                 CFNumberGetValue( value, kCFNumberIntType, &enabled ) &&
+                 (enabled == 0 || enabled == 1))
+            params->enabled = enabled;
+        else
+            status = STATUS_NOT_SUPPORTED;
+
+        CFRelease( proxies );
+        return status;
+    }
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    get_proxy_autodiscovery,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+/* The sole parameter is an inline 32-bit BOOL, not a native pointer. */
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    get_proxy_autodiscovery,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+#endif
diff --git a/dlls/winhttp/unixlib.h b/dlls/winhttp/unixlib.h
new file mode 100644
--- /dev/null
+++ b/dlls/winhttp/unixlib.h
@@ -0,0 +1,39 @@
