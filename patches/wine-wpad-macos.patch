+
+#ifndef __WINHTTP_UNIXLIB_H
+#define __WINHTTP_UNIXLIB_H
+
+#include "wine/unixlib.h"
+
+/* No pointers: the native and WOW64 Unix-call parameter layouts are identical. */
+struct proxy_autodiscovery_params
+{
+    BOOL enabled;
+};
+
+C_ASSERT( sizeof(struct proxy_autodiscovery_params) == 4 );
+
+enum winhttp_unix_funcs
+{
+    unix_get_proxy_autodiscovery,
+    unix_funcs_count
+};
+
+#endif
