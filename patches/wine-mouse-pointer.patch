+/* Mouse-only backport of Wine 71b686ce9fdce65416080c834a9103a743dc095c
+ * (Remi Bernon) and 2448865d5b84a00fa7a9c99a40afa628d153851a
+ * (Anna Figueiredo Gomes). Keep the frame private to win32u so the shared
+ * ntuser_thread_info ABI and the syscall table remain unchanged. */
+static void send_mouse_pointer_message( const MSG *msg, POINT screen_pos, ULONG_PTR extra_info )
+{
+    static LONG frame_id;
+    POINTER_INFO *info = &get_user_thread_info()->mouse_pointer_info;
+    POINTER_BUTTON_CHANGE_TYPE change = POINTER_CHANGE_NONE;
+    POINTER_FLAGS flags = POINTER_FLAG_INRANGE | POINTER_FLAG_PRIMARY;
+    UINT message, dpi, keys = LOWORD( msg->wParam );
+    WORD message_flags;
+    LARGE_INTEGER counter;
+
+    /* Touch/pen promotion already has its own pointer messages. */
+    if ((extra_info & 0xffffff00) == 0xff515700 || !NtUserIsMouseInPointerEnabled()) return;
+
+    switch (msg->message)
+    {
+    case WM_MOUSEMOVE: message = WM_POINTERUPDATE; flags |= POINTER_FLAG_UPDATE; break;
+    case WM_LBUTTONDOWN:
+        message = WM_POINTERDOWN; flags |= POINTER_FLAG_DOWN; change = POINTER_CHANGE_FIRSTBUTTON_DOWN; break;
+    case WM_LBUTTONUP:
+        message = WM_POINTERUP; flags |= POINTER_FLAG_UP; change = POINTER_CHANGE_FIRSTBUTTON_UP; break;
+    case WM_RBUTTONDOWN:
+        message = WM_POINTERDOWN; flags |= POINTER_FLAG_DOWN; change = POINTER_CHANGE_SECONDBUTTON_DOWN; break;
+    case WM_RBUTTONUP:
+        message = WM_POINTERUP; flags |= POINTER_FLAG_UP; change = POINTER_CHANGE_SECONDBUTTON_UP; break;
+    case WM_MBUTTONDOWN:
+        message = WM_POINTERDOWN; flags |= POINTER_FLAG_DOWN; change = POINTER_CHANGE_THIRDBUTTON_DOWN; break;
+    case WM_MBUTTONUP:
+        message = WM_POINTERUP; flags |= POINTER_FLAG_UP; change = POINTER_CHANGE_THIRDBUTTON_UP; break;
+    case WM_XBUTTONDOWN:
+        message = WM_POINTERDOWN;
+        flags |= POINTER_FLAG_DOWN;
+        if (HIWORD( msg->wParam ) == XBUTTON1) change = POINTER_CHANGE_FOURTHBUTTON_DOWN;
+        else if (HIWORD( msg->wParam ) == XBUTTON2) change = POINTER_CHANGE_FIFTHBUTTON_DOWN;
+        break;
+    case WM_XBUTTONUP:
+        message = WM_POINTERUP;
+        flags |= POINTER_FLAG_UP;
+        if (HIWORD( msg->wParam ) == XBUTTON1) change = POINTER_CHANGE_FOURTHBUTTON_UP;
+        else if (HIWORD( msg->wParam ) == XBUTTON2) change = POINTER_CHANGE_FIFTHBUTTON_UP;
+        break;
+    case WM_MOUSEWHEEL: message = WM_POINTERWHEEL; flags |= POINTER_FLAG_WHEEL; break;
+    case WM_MOUSEHWHEEL: message = WM_POINTERHWHEEL; flags |= POINTER_FLAG_HWHEEL; break;
+    default: return;
+    }
+
+    /* The server snapshots all five buttons after each transition. Do not
+     * query asynchronous state or replace the held buttons with just the
+     * changed button: both lose drag / multi-button state. */
+    if (keys & MK_LBUTTON) flags |= POINTER_FLAG_FIRSTBUTTON;
+    if (keys & MK_RBUTTON) flags |= POINTER_FLAG_SECONDBUTTON;
+    if (keys & MK_MBUTTON) flags |= POINTER_FLAG_THIRDBUTTON;
+    if (keys & MK_XBUTTON1) flags |= POINTER_FLAG_FOURTHBUTTON;
+    if (keys & MK_XBUTTON2) flags |= POINTER_FLAG_FIFTHBUTTON;
+    if (keys & (MK_LBUTTON | MK_RBUTTON | MK_MBUTTON | MK_XBUTTON1 | MK_XBUTTON2))
+        flags |= POINTER_FLAG_INCONTACT;
+
+    /* Only the low 16 bits are POINTER_MESSAGE_FLAG_* values. Wheel
+     * messages instead carry a signed delta in the entire high word. */
+    message_flags = LOWORD( flags );
+    info->InputData = 0;
+    if (message == WM_POINTERWHEEL || message == WM_POINTERHWHEEL)
+    {
+        message_flags = HIWORD( msg->wParam );
+        info->InputData = (SHORT)message_flags;
+    }
+
+    info->pointerType = PT_MOUSE;
+    info->pointerId = 1;
+    do info->frameId = InterlockedIncrement( &frame_id ); while (!info->frameId);
+    info->pointerFlags = flags;
+    info->sourceDevice = INVALID_HANDLE_VALUE;
+    info->hwndTarget = msg->hwnd;
+    info->ptPixelLocation = info->ptPixelLocationRaw = screen_pos;
+    dpi = get_system_dpi();
+    info->ptHimetricLocation.x = (LONGLONG)screen_pos.x * 2540 / dpi;
+    info->ptHimetricLocation.y = (LONGLONG)screen_pos.y * 2540 / dpi;
+    info->ptHimetricLocationRaw = info->ptHimetricLocation;
+    info->dwTime = msg->time;
+    info->historyCount = 1;
+    info->dwKeyStates = keys & (MK_SHIFT | MK_CONTROL);
+    NtQueryPerformanceCounter( &counter, NULL );
+    info->PerformanceCount = counter.QuadPart;
+    info->ButtonChangeType = change;
+
+    send_message( msg->hwnd, message, MAKELONG( 1, message_flags ), MAKELONG( screen_pos.x, screen_pos.y ) );
+}
