+static macdrv_metal_layer metal_get_layer(macdrv_metal_view view)
+{
+    struct macdrv_client_surface *surface;
+    macdrv_metal_layer layer;
+    if (!view) return NULL;
+    if (!(surface = metal_find_surface(view)))
+        return (macdrv_metal_layer)(UINT_PTR)macdrv_metal_remote_call(
+            METAL_REMOTE_LAYER, (UINT_PTR)view, 0, 0);
+    layer = macdrv_view_get_metal_layer(view);
+    client_surface_release(&surface->client);
+    return layer;
+}
