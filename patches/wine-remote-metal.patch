+/* These sets are main-thread-only and own only live context/host resources. */
+static NSMutableSet *remote_context_views, *remote_host_layers;
+
+/* A live HWND reuses its exported layer. This is also the lifetime boundary
+ * for D3DMetal, whose historical ABI omits the release-view notification.
+ * Recreating a swapchain therefore does not accumulate contexts or require a
+ * guessed first-frame timeout. DXMT can still relinquish it explicitly. */
+@interface WineRemoteMetalLayer : CAMetalLayer
+@end
+
+@implementation WineRemoteMetalLayer
+- (void) setDrawableSize:(CGSize)size
+{
+    dispatch_block_t update = ^{
+        CGFloat scale = self.contentsScale ?: 1.0;
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        [super setDrawableSize:size];
+        self.bounds = CGRectMake(0, 0, size.width / scale, size.height / scale);
+        [CATransaction commit];
+    };
+    if ([NSThread isMainThread]) update();
+    else OnMainThread(update);
+}
+@end
+
+/* The historical Metal bridge returns an actual NSView. D3DMetal sends
+ * -frame directly, in addition to using the driver get-layer callback.
+ * This detached view supplies geometry, while CAContext owns the exported
+ * layer. Never make it an AppKit backing layer: Metal HUD follows NS_view to
+ * a window and calls its screen IMP without checking for a nil window. */
+@interface WineRemoteMetalView : WineBaseView
+{
+    CAContext *_remoteContext;
+}
+@property(retain) CAContext *remoteContext;
+@end
+
+@implementation WineRemoteMetalView
+@synthesize remoteContext = _remoteContext;
+- (void) dealloc
+{
+    _remoteContext.layer = nil;
+    [_remoteContext release];
+    [super dealloc];
+}
+@end
+
+void *macdrv_remote_create_context(macdrv_metal_device device, CGRect bounds, unsigned int *context_id)
+{
+    __block WineRemoteMetalView *view = nil;
+    *context_id = 0;
+    if (!device) return NULL;
+    OnMainThread(^{
+        Class contextClass = NSClassFromString(@"CAContext");
+        if (![contextClass respondsToSelector:@selector(contextWithCGSConnection:options:)]) return;
+        if (!remote_context_views && !(remote_context_views = [[NSMutableSet alloc] init])) return;
+        WineRemoteMetalLayer *layer = [[WineRemoteMetalLayer alloc] init];
+        if (!layer) return;
+        layer.device = (id<MTLDevice>)device;
+        layer.framebufferOnly = YES;
+        layer.magnificationFilter = kCAFilterNearest;
+        layer.contentsScale = retina_on ? 2.0 : 1.0;
+        /* bounds enters in raw pixels. Convert exactly once, not at callers. */
+        layer.bounds = cgrect_mac_from_win(bounds);
+        layer.anchorPoint = CGPointZero;
+        layer.drawableSize = bounds.size;
+        CAContext *context = [[contextClass contextWithCGSConnection:CGSMainConnectionID()
+                                                           options:[NSDictionary dictionary]] retain];
+        if (![context respondsToSelector:@selector(setLayer:)] ||
+            ![context respondsToSelector:@selector(contextId)] || !context.contextId)
+        {
+            [layer release];
+            [context release];
+            return;
+        }
+        if ((view = [[WineRemoteMetalView alloc] initWithFrame:cgrect_mac_from_win(bounds)]))
+        {
+            view.remoteContext = context;
+            context.layer = layer;
+            [remote_context_views addObject:view];
+            *context_id = context.contextId;
+        }
+        [context release];
+        [layer release];
+    });
+    return view;
+}
+
+macdrv_metal_layer macdrv_remote_context_layer(void *opaque, macdrv_metal_device device, bool retain)
+{
+    __block CAMetalLayer *layer = nil;
+    OnMainThread(^{
+        layer = (CAMetalLayer *)[(WineRemoteMetalView *)opaque remoteContext].layer;
+        if (device) layer.device = (id<MTLDevice>)device;
+        if (retain) [layer retain];
+    });
+    return (macdrv_metal_layer)layer;
+}
+
+void macdrv_remote_update_context(void *opaque, CGRect bounds)
+{
+    OnMainThread(^{
+        WineRemoteMetalView *view = opaque;
+        CAMetalLayer *layer = (CAMetalLayer *)view.remoteContext.layer;
+        CGSize pixels = layer.drawableSize;
+        view.frame = cgrect_mac_from_win(bounds);
+        layer.contentsScale = retina_on ? 2.0 : 1.0;
+        layer.bounds = CGRectMake(0, 0, pixels.width / layer.contentsScale, pixels.height / layer.contentsScale);
+    });
+}
+
+void macdrv_remote_invalidate_context(void *opaque)
+{
+    if (!opaque) return;
+    OnMainThread(^{
+        WineRemoteMetalView *view = opaque;
+        [remote_context_views removeObject:view];
+        view.remoteContext.layer = nil;
+        view.remoteContext = nil;
+    });
+}
+
+void macdrv_remote_destroy_context(void *opaque)
+{
+    macdrv_remote_invalidate_context(opaque);
+    if (opaque) OnMainThread(^{ [(WineRemoteMetalView *)opaque release]; });
+}
+
+void *macdrv_remote_create_host(unsigned int context_id)
+{
+    __block CALayer *clip = nil;
+    OnMainThread(^{
+        Class hostClass = NSClassFromString(@"CALayerHost");
+        if (![hostClass instancesRespondToSelector:@selector(setContextId:)]) return;
+        if (!remote_host_layers && !(remote_host_layers = [[NSMutableSet alloc] init])) return;
+        CALayerHost *host = [[hostClass alloc] init];
+        if (!host) return;
+        clip = [[CALayer alloc] init];
+        CAShapeLayer *mask = [[CAShapeLayer alloc] init];
+        if (!mask) { [clip release]; clip = nil; }
+        if (clip)
+        {
+            [host setContextId:context_id];
+            host.magnificationFilter = kCAFilterNearest;
+            host.contentsScale = retina_on ? 2.0 : 1.0;
+            host.anchorPoint = CGPointZero;
+            host.masksToBounds = YES;
+            clip.masksToBounds = YES;
+            clip.geometryFlipped = YES;
+            clip.hidden = YES;
+            clip.contentsScale = retina_on ? 2.0 : 1.0;
+            clip.mask = mask;
+            [remote_host_layers addObject:clip];
+            [clip addSublayer:host];
+        }
+        [host release];
+        [mask release];
+    });
+    return clip;
+}
+
+bool macdrv_remote_update_host(void *opaque, macdrv_window w, CGRect frame, CGRect clipped,
+                               const CGRect *visible_rects, unsigned int count, double z, bool visible)
+{
+    __block bool result = true;
+    OnMainThread(^{
+        CALayer *clip = opaque;
+        CALayerHost *host = (CALayerHost *)clip.sublayers.firstObject;
+        WineWindow *window = (WineWindow *)w;
+        NSView *view = window.contentView;
+        CGMutablePathRef path;
+        if (!clip || !host || (view && ![view isKindOfClass:[WineContentView class]]))
+        {
+            result = false;
+            [window release];
+            return;
+        }
+        if (!(path = CGPathCreateMutable()))
+        {
+            result = false;
+            [window release];
+            return;
+        }
+        for (unsigned int i = 0; i < count; ++i)
+            CGPathAddRect(path, NULL, cgrect_mac_from_win(visible_rects[i]));
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        ((CAShapeLayer *)clip.mask).path = path;
+        CGPathRelease(path);
+        if (!view)
+        {
+            /* A real allocated host can be pending before native realization. */
+            [clip removeFromSuperlayer];
+            clip.hidden = YES;
+        }
+        else
+        {
+            CGRect f = cgrect_mac_from_win(frame), c = cgrect_mac_from_win(clipped);
+            CGPoint offset = CGPointMake(f.origin.x - c.origin.x, f.origin.y - c.origin.y);
+            if (!view.layer.geometryFlipped)
+                c.origin.y = view.layer.bounds.size.height - c.origin.y - c.size.height;
+            if (clip.superlayer != view.layer) [view.layer addSublayer:clip];
+            clip.frame = c;
+            clip.mask.frame = clip.bounds;
+            clip.zPosition = z;
+            clip.hidden = !visible || !count || CGRectIsEmpty(c);
+            host.contentsScale = retina_on ? 2.0 : 1.0;
+            clip.contentsScale = host.contentsScale;
+            host.frame = (CGRect){offset, f.size};
+            [(WineWindow *)view.window windowDidDrawContent];
+        }
+        [CATransaction commit];
+        /* Consume the retain taken under win_data_mutex, on the Cocoa thread. */
+        [window release];
+    });
+    return result;
+}
+
+void macdrv_remote_destroy_host(void *opaque)
+{
+    if (!opaque) return;
+    OnMainThread(^{
+        CALayer *clip = opaque;
+        [clip removeFromSuperlayer];
+        [remote_host_layers removeObject:clip];
+        [clip release];
+    });
+}
+
+void macdrv_remote_set_retina_mode(bool mode)
+{
+    CGFloat scale = mode ? 2.0 : 1.0;
+    /* Called inline after the native windows have changed coordinate units.
+     * Detached contexts are not visited by WineBaseView's descendant walk. */
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    for (WineRemoteMetalView *view in remote_context_views)
+    {
+        CAMetalLayer *layer = (CAMetalLayer *)view.remoteContext.layer;
+        CGSize pixels = layer.drawableSize;
+        CGFloat ratio = layer.contentsScale / scale;
+        view.frame = CGRectApplyAffineTransform(view.frame, CGAffineTransformMakeScale(ratio, ratio));
+        layer.contentsScale = scale;
+        layer.bounds = CGRectMake(0, 0, pixels.width / scale, pixels.height / scale);
+    }
+    for (CALayer *clip in remote_host_layers)
+    {
+        CALayerHost *host = (CALayerHost *)clip.sublayers.firstObject;
+        CAShapeLayer *mask = (CAShapeLayer *)clip.mask;
+        CGFloat ratio = clip.contentsScale / scale;
+        CGAffineTransform units = CGAffineTransformMakeScale(ratio, ratio);
+        clip.frame = CGRectApplyAffineTransform(clip.frame, units);
+        mask.frame = clip.bounds;
+        host.frame = CGRectApplyAffineTransform(host.frame, units);
+        if (mask.path)
+        {
+            CGPathRef path = CGPathCreateCopyByTransformingPath(mask.path, &units);
+            mask.path = path;
+            CGPathRelease(path);
+        }
+        clip.contentsScale = host.contentsScale = scale;
+    }
+    [CATransaction commit];
+}
