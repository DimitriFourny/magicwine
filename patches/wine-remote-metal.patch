+/*
+ * Wine-thread service for cross-process Metal presentation.
+ * Copyright 2026 MagicWine contributors
+ * LGPL-2.1-or-later; see COPYING.LIB.
+ */
+#include <stdarg.h>
+#include <stdlib.h>
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "unixlib.h"
+#include "wine/list.h"
+
+static INIT_ONCE service_once = INIT_ONCE_STATIC_INIT;
+static HWND service_window;
+static struct list watches = LIST_INIT(watches);
+static UINT_PTR next_watch;
+
+struct process_watch
+{
+    struct list entry;
+    HANDLE process, wait;
+    UINT_PTR serial;
+};
+
+static void CALLBACK process_exited(void *arg, BOOLEAN timed_out)
+{
+    struct process_watch *watch = arg;
+    /* This callback owns no native state and never waits for the service. */
+    PostMessageW(service_window, WM_METAL_REMOTE_DEAD, watch->serial, 0);
+}
+
+UINT64 metal_remote_watch(DWORD pid)
+{
+    struct process_watch *watch;
+    if (pid == GetCurrentProcessId()) return ~(UINT64)0;
+    if (!next_watch || !(watch = calloc(1, sizeof(*watch)))) return 0;
+    watch->serial = next_watch++;
+    if (!(watch->process = OpenProcess(SYNCHRONIZE, FALSE, pid))) goto failed;
+    if (!RegisterWaitForSingleObject(&watch->wait, watch->process, process_exited, watch,
+                                     INFINITE, WT_EXECUTEONLYONCE)) goto failed;
+    list_add_tail(&watches, &watch->entry);
+    return watch->serial;
+failed:
+    if (watch->process) CloseHandle(watch->process);
+    free(watch);
+    return 0;
+}
+
+void metal_remote_unwatch(UINT64 cookie)
+{
+    struct process_watch *watch;
+    if (!cookie || cookie == ~(UINT64)0) return;
+    LIST_FOR_EACH_ENTRY(watch, &watches, struct process_watch, entry)
+        if (watch->serial == cookie)
+        {
+            list_remove(&watch->entry);
+            /* The callback only posts; draining it cannot wait on our thread. */
+            UnregisterWaitEx(watch->wait, INVALID_HANDLE_VALUE);
+            CloseHandle(watch->process);
+            free(watch);
+            return;
+        }
+}
+
+static LRESULT CALLBACK service_proc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    struct metal_win32_params params = {0};
+    struct process_watch *watch;
+    if (msg == WM_METAL_REMOTE_CALL)
+    {
+        MACDRV_CALL(metal_remote, (void *)lp);
+        return 0; /* The 64-bit result is in the packet, including on PE32. */
+    }
+    if (msg == WM_METAL_REMOTE_DEAD)
+    {
+        LIST_FOR_EACH_ENTRY(watch, &watches, struct process_watch, entry)
+            if (watch->serial == wp)
+            {
+                params.args[0] = METAL_REMOTE_DEAD;
+                params.args[1] = watch->serial;
+                MACDRV_CALL(metal_remote, &params);
+                break;
+            }
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+static void CALLBACK window_event(HWINEVENTHOOK hook, DWORD event, HWND hwnd,
+                                  LONG object, LONG child, DWORD thread, DWORD time)
+{
+    struct metal_win32_params params = {0};
+    if (!hwnd || child || (object != OBJID_WINDOW && object != OBJID_CLIENT)) return;
+    switch (event)
+    {
+    case EVENT_OBJECT_CREATE:
+    case EVENT_OBJECT_DESTROY:
+    case EVENT_OBJECT_SHOW:
+    case EVENT_OBJECT_HIDE:
+    case EVENT_OBJECT_REORDER:
+    case EVENT_OBJECT_LOCATIONCHANGE:
+    case EVENT_OBJECT_STATECHANGE:
+    case EVENT_OBJECT_PARENTCHANGE:
+    case EVENT_SYSTEM_MINIMIZESTART:
+    case EVENT_SYSTEM_MINIMIZEEND:
+        break;
+    default:
+        return;
+    }
+    params.args[0] = METAL_REMOTE_EVENT;
+    params.args[1] = event;
+    params.args[2] = (UINT_PTR)hwnd;
+    params.args[3] = time;
+    MACDRV_CALL(metal_remote, &params);
+}
+
+struct service_start
+{
+    HANDLE ready;
+    BOOL success;
+};
+
+static DWORD WINAPI service_thread(void *arg)
+{
+    struct service_start *start = arg;
+    struct metal_win32_params params = {0};
+    WNDCLASSW cls = {0};
+    HWINEVENTHOOK objects = NULL, minimize = NULL;
+    HWND window = NULL;
+    MSG msg;
+
+    cls.lpfnWndProc = service_proc;
+    cls.lpszClassName = L"WineMetalRemoteService";
+    cls.hInstance = GetModuleHandleW(L"winemac.drv");
+    if (!RegisterClassW(&cls) && GetLastError() != ERROR_CLASS_ALREADY_EXISTS) goto failed;
+    if (!(window = CreateWindowExW(0, cls.lpszClassName, NULL, 0, 0, 0, 0, 0,
+                                   HWND_MESSAGE, NULL, cls.hInstance, NULL))) goto failed;
+    objects = SetWinEventHook(EVENT_OBJECT_CREATE, EVENT_OBJECT_PARENTCHANGE, NULL, window_event,
+                              0, 0, WINEVENT_OUTOFCONTEXT);
+    minimize = SetWinEventHook(EVENT_SYSTEM_MINIMIZESTART, EVENT_SYSTEM_MINIMIZEEND, NULL,
+                               window_event, 0, 0, WINEVENT_OUTOFCONTEXT);
+    if (!objects || !minimize) goto failed;
+    service_window = window;
+    next_watch = 1;
+    params.args[0] = METAL_REMOTE_SERVICE;
+    params.args[1] = (UINT_PTR)window;
+    MACDRV_CALL(metal_remote, &params);
+    start->success = TRUE;
+    SetEvent(start->ready);
+    while (GetMessageW(&msg, NULL, 0, 0) > 0) DispatchMessageW(&msg);
+    return 0;
+failed:
+    if (objects) UnhookWinEvent(objects);
+    if (minimize) UnhookWinEvent(minimize);
+    if (window) DestroyWindow(window);
+    start->success = FALSE;
+    SetEvent(start->ready);
+    return 0;
+}
+
+static BOOL CALLBACK start_service(INIT_ONCE *once, void *param, void **context)
+{
+    struct service_start start = {0};
+    HANDLE thread;
+    if (!(start.ready = CreateEventW(NULL, TRUE, FALSE, NULL))) return FALSE;
+    thread = CreateThread(NULL, 0, service_thread, &start, 0, NULL);
+    if (thread)
+    {
+        WaitForSingleObject(start.ready, INFINITE);
+        CloseHandle(thread);
+    }
+    CloseHandle(start.ready);
+    return start.success;
+}
+
+UINT64 metal_remote_dispatch(struct metal_win32_params *params)
+{
+    /* Deliberately lazy: no worker creation or wait from DllMain. */
+    if (!InitOnceExecuteOnce(&service_once, start_service, NULL, NULL)) return 0;
+    SendMessageW(service_window, WM_METAL_REMOTE_CALL, 0, (LPARAM)params);
+    return params->result;
+}
