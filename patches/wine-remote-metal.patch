+/*
+ * Cross-process Metal presentation for the historical winemac bridge.
+ * Copyright 2026 MagicWine contributors
+ *
+ * CAContext transport backported from Wine commit
+ * 1a63b0d7c431f1ebbaba9afd2daa312690eb8020, Marc-Aurel Zent / CodeWeavers.
+ * LGPL-2.1-or-later; see COPYING.LIB.
+ */
+#if 0
+#pragma makedep unix
+#endif
+#include "config.h"
+#include <stdlib.h>
+#include <limits.h>
+#include "macdrv.h"
+#include "wine/list.h"
+#include "wine/debug.h"
+#include "wine/server.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+/* Only the lazy PE service's Wine thread accesses these lists. In particular,
+ * there is no registry/window/surface lock across owner IPC or OnMainThread.
+ * The service's HWND identifies the producer for scalar driver messages; this
+ * uses Wine's existing same-desktop trust model, not an external IPC broker. */
+static HWND service_window;
+static UINT64 next_token = 1;
+static struct list producers = LIST_INIT(producers), hosts = LIST_INIT(hosts);
+static struct list retired_producers = LIST_INIT(retired_producers);
+
+struct remote_producer
+{
+    struct list entry;
+    HWND hwnd, root;
+    DWORD pid, root_pid, created;
+    UINT64 token, users, explicit_users, target_watch, root_watch, pins;
+    unsigned int context_id;
+    BOOL dead;
+    void *context;
+};
+
+struct remote_host
+{
+    struct list entry;
+    HWND hwnd, root, producer;
+    DWORD pid, created;
+    UINT64 producer_watch;
+    unsigned int context_id;
+    void *host;
+};
+
+UINT64 macdrv_metal_remote_call(UINT command, UINT64 a, UINT64 b, UINT64 c)
+{
+    const UINT64 args[] = {command, a, b, c};
+    return macdrv_metal_win32_call(METAL_REMOTE_DISPATCH, args, ARRAY_SIZE(args));
+}
+
+void macdrv_metal_remote_update(HWND hwnd)
+{
+    /* Never start a service for an ordinary local window, or synchronously
+     * enter it while a driver's win_data_mutex might still be held. */
+    HWND service = InterlockedCompareExchangePointer((void **)&service_window, NULL, NULL);
+    if (service) NtUserPostMessage(service, WM_MACDRV_UPDATE_REMOTE_LAYERS,
+                                   (WPARAM)hwnd, NtGetTickCount());
+}
+
+static UINT64 watch_process(DWORD pid)
+{
+    const UINT64 args[] = {pid};
+    return macdrv_metal_win32_call(METAL_REMOTE_WATCH, args, ARRAY_SIZE(args));
+}
+
+static void unwatch_process(UINT64 watch)
+{
+    macdrv_metal_win32_call(METAL_REMOTE_UNWATCH, &watch, 1);
+}
+
+static DWORD window_pid(HWND hwnd)
+{
+    DWORD pid = 0;
+    NtUserGetWindowThread(hwnd, &pid);
+    return pid;
+}
+
+static struct remote_producer *find_producer(UINT64 token)
+{
+    struct remote_producer *producer;
+    LIST_FOR_EACH_ENTRY(producer, &producers, struct remote_producer, entry)
+        if (producer->token == token || (UINT_PTR)producer->context == token) return producer;
+    LIST_FOR_EACH_ENTRY(producer, &retired_producers, struct remote_producer, entry)
+        if (producer->token == token || (UINT_PTR)producer->context == token) return producer;
+    return NULL;
+}
+
+static void free_producer(struct remote_producer *producer)
+{
+    if (producer->dead) list_remove(&producer->entry);
+    macdrv_remote_destroy_context(producer->context);
+    unwatch_process(producer->target_watch);
+    unwatch_process(producer->root_watch);
+    free(producer);
+}
+
+static void finish_dead_producer(struct remote_producer *producer)
+{
+    if (producer->pins) return;
+    if (!producer->explicit_users) { free_producer(producer); return; }
+    /* An owned layer handoff is paired with the consumer's explicit release.
+     * Tear down presentation now, but keep its real NSView identity allocated
+     * until that release; otherwise an allocator reuse could release a new
+     * HWND's view. D3DMetal never requests this owned handoff. */
+    macdrv_remote_invalidate_context(producer->context);
+    unwatch_process(producer->target_watch);
+    unwatch_process(producer->root_watch);
+    producer->target_watch = producer->root_watch = 0;
+}
+
+static void remove_producer(struct remote_producer *producer)
+{
+    if (producer->dead) return;
+    list_remove(&producer->entry);
+    list_add_tail(&retired_producers, &producer->entry);
+    producer->dead = TRUE;
+    ++producer->pins;
+    if (producer->context_id && producer->root)
+        NtUserPostMessage(producer->root, WM_MACDRV_RELEASE_REMOTE_LAYER,
+                     (WPARAM)service_window, producer->context_id);
+    --producer->pins;
+    finish_dead_producer(producer);
+}
+
+static void remove_host(struct remote_host *host)
+{
+    list_remove(&host->entry);
+    macdrv_remote_destroy_host(host->host);
+    unwatch_process(host->producer_watch);
+    free(host);
+}
+
+/* Win32 bottom-to-top, parent before descendants. A context's creation order
+ * must never reorder siblings. Iterative traversal also handles nested HWNDs. */
+static BOOL paint_order(HWND root, HWND target, double *result)
+{
+    HWND current = root, child, next;
+    double order = 0;
+    while (current)
+    {
+        if (current == target) { *result = order; return TRUE; }
+        ++order;
+        child = NtUserGetWindowRelative(current, GW_CHILD);
+        if (child)
+        {
+            current = NtUserGetWindowRelative(child, GW_HWNDLAST);
+            continue;
+        }
+        while (current && current != root && !(next = NtUserGetWindowRelative(current, GW_HWNDPREV)))
+            current = NtUserGetAncestor(current, GA_PARENT);
+        if (!current || current == root) break;
+        current = next;
+    }
+    return FALSE;
+}
+
+/* The server supplies shaped, ancestor-clipped rectangles in screen pixels.
+ * Use the existing region protocol without allocating a DC or a GDI surface. */
+static HRGN visible_region(HWND hwnd, UINT flags)
+{
+    size_t size = 256;
+    RGNDATA *data;
+    HRGN region = 0;
+    NTSTATUS status;
+    do
+    {
+        if (!(data = malloc(sizeof(*data) + size))) return 0;
+        SERVER_START_REQ(get_visible_region)
+        {
+            req->window = wine_server_user_handle(hwnd);
+            req->flags = flags;
+            wine_server_set_reply(req, data->Buffer, size);
+            if (!(status = wine_server_call(req)))
+            {
+                data->rdh.dwSize = sizeof(data->rdh);
+                data->rdh.iType = RDH_RECTANGLES;
+                data->rdh.nCount = wine_server_reply_size(reply) / sizeof(RECT);
+                data->rdh.nRgnSize = wine_server_reply_size(reply);
+                region = NtGdiExtCreateRegion(NULL, data->rdh.dwSize + data->rdh.nRgnSize, data);
+            }
+            else size = reply->total_size;
+        }
+        SERVER_END_REQ;
+        free(data);
+    } while (status == STATUS_BUFFER_OVERFLOW);
+    return region;
+}
+
+static HRGN host_visible_region(HWND hwnd, HWND root)
+{
+    HWND current, sibling;
+    HRGN region, obscured;
+    if (!(region = visible_region(hwnd, DCX_CLIPCHILDREN))) return 0;
+    for (current = hwnd; current && current != root; current = NtUserGetAncestor(current, GA_PARENT))
+    {
+        /* GPU hosts must also respect siblings without WS_CLIPSIBLINGS: their
+         * pixels may live in local Metal/GL views or in the root GDI surface. */
+        for (sibling = NtUserGetWindowRelative(current, GW_HWNDPREV); sibling;
+             sibling = NtUserGetWindowRelative(sibling, GW_HWNDPREV))
+        {
+            if (!(NtUserGetWindowLongW(sibling, GWL_STYLE) & WS_VISIBLE) ||
+                (NtUserGetWindowLongW(sibling, GWL_EXSTYLE) & WS_EX_TRANSPARENT)) continue;
+            if (!(obscured = visible_region(sibling, DCX_WINDOW))) goto failed;
+            if (NtGdiCombineRgn(region, region, obscured, RGN_DIFF) == ERROR)
+            {
+                NtGdiDeleteObjectApp(obscured);
+                goto failed;
+            }
+            NtGdiDeleteObjectApp(obscured);
+        }
+    }
+    if (current == root) return region;
+failed:
+    NtGdiDeleteObjectApp(region);
+    return 0;
+}
+
+static BOOL update_host(struct remote_host *host)
+{
+    struct macdrv_win_data *data;
+    macdrv_window window = NULL;
+    HWND parent;
+    double order;
+    RECT frame, clip, rect;
+    INT dx = 0, dy = 0;
+    UINT dpi = NtUserGetWinMonitorDpi(host->root, MDT_RAW_DPI);
+    HRGN region;
+    RGNDATA *mask;
+    POINT origin = {0};
+    BOOL visible = TRUE, result;
+
+    if (!paint_order(host->root, host->hwnd, &order)) return FALSE;
+    if (!NtUserGetClientRect(host->hwnd, &frame, dpi)) return FALSE;
+    NtUserMapWindowPoints(host->hwnd, host->root, (POINT *)&frame, 2, dpi);
+    clip = frame;
+    for (parent = host->hwnd; parent; parent = NtUserGetAncestor(parent, GA_PARENT))
+    {
+        DWORD style = NtUserGetWindowLongW(parent, GWL_STYLE);
+        if (!(style & WS_VISIBLE) || (style & WS_MINIMIZE)) visible = FALSE;
+        if (!NtUserGetClientRect(parent, &rect, dpi)) return FALSE;
+        NtUserMapWindowPoints(parent, host->root, (POINT *)&rect, 2, dpi);
+        intersect_rect(&clip, &clip, &rect);
+        if (parent == host->root) break;
+    }
+    if (!parent) return FALSE;
+    if (!(region = host_visible_region(host->hwnd, host->root))) return FALSE;
+    NtUserMapWindowPoints(host->root, NULL, &origin, 1, dpi);
+    NtGdiOffsetRgn(region, -origin.x - clip.left, -origin.y - clip.top);
+    mask = get_region_data(region, NULL);
+    NtGdiDeleteObjectApp(region);
+    if (!mask) return FALSE;
+    if ((data = get_win_data(host->root)))
+    {
+        if ((window = data->cocoa_window)) CFRetain(window);
+        dx = data->rects.client.left - data->rects.visible.left;
+        dy = data->rects.client.top - data->rects.visible.top;
+        release_win_data(data);
+    }
+    OffsetRect(&frame, dx, dy);
+    OffsetRect(&clip, dx, dy);
+    /* All rectangles above are raw Win32 pixels. The Cocoa boundary converts
+     * once, including zero-area children; no edge snapping or frame scaling. */
+    result = macdrv_remote_update_host(host->host, window, cgrect_from_rect(frame),
+                                       cgrect_from_rect(clip), (CGRect *)mask->Buffer, mask->rdh.nCount,
+                                       order, visible);
+    free(mask);
+    return result;
+}
+
+static BOOL host_context(HWND root, HWND source, unsigned int context_id)
+{
+    struct remote_host *host;
+    HWND hwnd;
+    DWORD pid;
+    if (!context_id || window_pid(root) != GetCurrentProcessId() || !(pid = window_pid(source))) return FALSE;
+    /* The owner may have been blocked in CEF while CREATE was queued. Query
+     * the producer service, never the application's window thread, and reject
+     * an attachment whose target has since moved or been destroyed. */
+    hwnd = (HWND)send_message(source, WM_MACDRV_QUERY_REMOTE_LAYER, 0, context_id);
+    if (!hwnd || NtUserGetAncestor(hwnd, GA_ROOT) != root) return FALSE;
+    LIST_FOR_EACH_ENTRY(host, &hosts, struct remote_host, entry)
+        if (host->producer == source && host->context_id == context_id)
+        {
+            if (host->root == root) return update_host(host);
+            /* Different root threads may drain their queues in either order.
+             * A late old-root RELEASE cannot remove this new-root host. */
+            remove_host(host);
+            break;
+        }
+    if (!(host = calloc(1, sizeof(*host)))) return FALSE;
+    host->hwnd = hwnd;
+    host->root = root;
+    host->producer = source;
+    host->pid = pid;
+    host->context_id = context_id;
+    host->created = NtGetTickCount();
+    host->producer_watch = watch_process(pid);
+    if (!host->producer_watch || !(host->host = macdrv_remote_create_host(context_id))) goto failed;
+    if (!update_host(host) || NtUserGetAncestor(hwnd, GA_ROOT) != root) goto failed;
+    list_add_tail(&hosts, &host->entry);
+    return TRUE;
+failed:
+    macdrv_remote_destroy_host(host->host);
+    unwatch_process(host->producer_watch);
+    free(host);
+    return FALSE;
+}
+
+static BOOL route_producer(struct remote_producer *producer)
+{
+    HWND root = NtUserGetAncestor(producer->hwnd, GA_ROOT);
+    DWORD pid = window_pid(root);
+    UINT64 watch;
+    LRESULT result;
+    if (!root || !pid) return FALSE;
+    if (root != producer->root || pid != producer->root_pid)
+    {
+        if (!(watch = watch_process(pid))) return FALSE;
+        /* Messages to each root remain FIFO, including A -> B -> A. Never
+         * wait for an application thread that may itself be waiting for GPU
+         * initialization. Host lookup validates the current root on receipt. */
+        if (producer->root && producer->context_id)
+            NtUserPostMessage(producer->root, WM_MACDRV_RELEASE_REMOTE_LAYER,
+                         (WPARAM)service_window, producer->context_id);
+        if (producer->dead) { unwatch_process(watch); return FALSE; }
+        unwatch_process(producer->root_watch);
+        producer->root = root;
+        producer->root_pid = pid;
+        producer->root_watch = watch;
+    }
+    result = NtUserPostMessage(root, WM_MACDRV_CREATE_REMOTE_LAYER,
+                          (WPARAM)service_window, producer->context_id);
+    return result && !producer->dead && NtUserGetAncestor(producer->hwnd, GA_ROOT) == root;
+}
+
+static UINT64 acquire_producer(HWND hwnd)
+{
+    struct remote_producer *producer;
+    DWORD pid = window_pid(hwnd);
+    if (!pid) return 0;
+    LIST_FOR_EACH_ENTRY(producer, &producers, struct remote_producer, entry)
+        if (producer->hwnd == hwnd && producer->pid == pid)
+        {
+            if (producer->users == ~(UINT64)0) return 0;
+            ++producer->users;
+            ++producer->pins;
+            return producer->token;
+        }
+    if (!next_token || !(producer = calloc(1, sizeof(*producer)))) return 0;
+    producer->hwnd = hwnd;
+    producer->pid = pid;
+    producer->created = NtGetTickCount();
+    producer->users = 1;
+    producer->pins = 1; /* metadata handoff, released by release_win_data */
+    /* Odd tokens are only get/create handoff handles, never Cocoa views.
+     * Never recycle them: a retired metadata release must not find a new HWND. */
+    producer->token = next_token;
+    next_token = next_token > ~(UINT64)0 - 2 ? 0 : next_token + 2;
+    if (!(producer->target_watch = watch_process(pid))) { free(producer); return 0; }
+    list_add_tail(&producers, &producer->entry);
+    return producer->token;
+}
+
+static void refresh_remote(DWORD event, HWND hwnd, DWORD time, UINT64 dead_watch)
+{
+    struct remote_host *host, *next;
+    struct remote_producer *producer, *candidate;
+    UINT64 token = 0;
+    RECT rect;
+
+    LIST_FOR_EACH_ENTRY_SAFE(host, next, &hosts, struct remote_host, entry)
+    {
+        if ((dead_watch && host->producer_watch == dead_watch) ||
+            (event == EVENT_OBJECT_DESTROY && (host->hwnd == hwnd || host->root == hwnd || host->producer == hwnd) &&
+             (INT)(time - host->created) >= 0) || !NtUserIsWindow(host->hwnd) ||
+            !NtUserIsWindow(host->producer) || NtUserGetAncestor(host->hwnd, GA_ROOT) != host->root)
+            remove_host(host);
+        else if ((event == EVENT_OBJECT_DESTROY || event == EVENT_OBJECT_PARENTCHANGE ||
+                  !hwnd || hwnd == host->root || NtUserGetAncestor(hwnd, GA_ROOT) == host->root) &&
+                 !update_host(host))
+        {
+            /* A live hierarchy can change while queried. Keep the registration
+             * pending, not partially ordered, so the next change can realize it. */
+            macdrv_remote_update_host(host->host, NULL, CGRectZero, CGRectZero, NULL, 0, 0, FALSE);
+        }
+    }
+    /* A send can service another command, so keep no list iterator across it.
+     * Pins defer object disposal, not context retirement by a fixed timer. */
+    for (;;)
+    {
+        producer = NULL;
+        LIST_FOR_EACH_ENTRY(candidate, &producers, struct remote_producer, entry)
+            if (candidate->token > token && (!producer || candidate->token < producer->token)) producer = candidate;
+        if (!producer) break;
+        token = producer->token;
+        if ((dead_watch && (producer->target_watch == dead_watch ||
+                           (producer->root_watch == dead_watch &&
+                            NtUserGetAncestor(producer->hwnd, GA_ROOT) == producer->root))) ||
+            (event == EVENT_OBJECT_DESTROY &&
+             (producer->hwnd == hwnd || (producer->root == hwnd &&
+              NtUserGetAncestor(producer->hwnd, GA_ROOT) == producer->root)) &&
+             (INT)(time - producer->created) >= 0) || window_pid(producer->hwnd) != producer->pid)
+        {
+            remove_producer(producer);
+            continue;
+        }
+        if (!producer->context_id) continue;
+        if (NtUserGetClientRect(producer->hwnd, &rect, NtUserGetWinMonitorDpi(producer->hwnd, MDT_RAW_DPI)))
+            macdrv_remote_update_context(producer->context, cgrect_from_rect(rect));
+        if (NtUserGetAncestor(producer->hwnd, GA_ROOT) != producer->root)
+        {
+            ++producer->pins;
+            if (!route_producer(producer) && !producer->dead)
+                remove_producer(producer);
+            if (!--producer->pins && producer->dead) finish_dead_producer(producer);
+        }
+    }
+}
+
+NTSTATUS macdrv_metal_remote(void *arg)
+{
+    struct metal_win32_params *params = arg;
+    const UINT64 *a = params->args;
+    struct remote_producer *producer;
+    struct remote_host *host, *next;
+    RECT rect;
+    UINT64 result = 0;
+
+    switch (a[0])
+    {
+    case METAL_REMOTE_SERVICE:
+        InterlockedExchangePointer((void **)&service_window, (void *)(UINT_PTR)a[1]);
+        result = 1;
+        break;
+    case METAL_REMOTE_ACQUIRE: result = acquire_producer((HWND)(UINT_PTR)a[1]); break;
+    case METAL_REMOTE_END_HANDOFF:
+        if ((producer = find_producer(a[1])) && !--producer->pins && producer->dead)
+            finish_dead_producer(producer);
+        break;
+    case METAL_REMOTE_HOST:
+        result = host_context((HWND)(UINT_PTR)a[1], (HWND)(UINT_PTR)a[2], a[3]);
+        break;
+    case METAL_REMOTE_UNHOST:
+        LIST_FOR_EACH_ENTRY_SAFE(host, next, &hosts, struct remote_host, entry)
+            if (host->root == (HWND)(UINT_PTR)a[1] && host->producer == (HWND)(UINT_PTR)a[2] && host->context_id == a[3])
+                remove_host(host);
+        break;
+    case METAL_REMOTE_QUERY:
+        if ((HWND)(UINT_PTR)a[2] != service_window) break;
+        LIST_FOR_EACH_ENTRY(producer, &producers, struct remote_producer, entry)
+            if (producer->context_id == a[1] && window_pid(producer->hwnd) == producer->pid)
+            { result = (UINT_PTR)producer->hwnd; break; }
+        break;
+    case METAL_REMOTE_EVENT: refresh_remote(a[1], (HWND)(UINT_PTR)a[2], a[3], 0); break;
+    case METAL_REMOTE_DEAD: refresh_remote(0, NULL, 0, a[1]); break;
+    case METAL_REMOTE_CREATE:
+    case METAL_REMOTE_LAYER:
+    case METAL_REMOTE_COPY_LAYER:
+    case METAL_REMOTE_RELEASE:
+        if (!(producer = find_producer(a[1]))) break;
+        if (producer->dead && a[0] != METAL_REMOTE_RELEASE) break;
+        ++producer->pins;
+        if (a[0] == METAL_REMOTE_RELEASE)
+        {
+            if (producer->explicit_users) --producer->explicit_users;
+            if (!--producer->users && !producer->dead) remove_producer(producer);
+        }
+        else if (a[0] == METAL_REMOTE_LAYER || a[0] == METAL_REMOTE_COPY_LAYER)
+        {
+            if (producer->context) result = (UINT_PTR)macdrv_remote_context_layer(
+                producer->context, NULL, a[0] == METAL_REMOTE_COPY_LAYER);
+            /* The optional owned handoff is used once per acquired view. */
+            if (result && a[0] == METAL_REMOTE_COPY_LAYER) ++producer->explicit_users;
+        }
+        else
+        {
+            if (!NtUserGetClientRect(producer->hwnd, &rect, NtUserGetWinMonitorDpi(producer->hwnd, MDT_RAW_DPI)))
+            {
+                remove_producer(producer);
+                goto unpin;
+            }
+            if (!producer->context)
+            {
+                producer->context = macdrv_remote_create_context((macdrv_metal_device)(UINT_PTR)a[2],
+                                                                 cgrect_from_rect(rect), &producer->context_id);
+                if (!producer->context || !route_producer(producer))
+                {
+                    if (!producer->dead) remove_producer(producer);
+                    goto unpin;
+                }
+            }
+            else if (NtUserGetAncestor(producer->hwnd, GA_ROOT) != producer->root &&
+                     !route_producer(producer))
+            {
+                if (!producer->dead) remove_producer(producer);
+                goto unpin;
+            }
+            macdrv_remote_update_context(producer->context, cgrect_from_rect(rect));
+            if (macdrv_remote_context_layer(producer->context, (macdrv_metal_device)(UINT_PTR)a[2], FALSE))
+                result = (UINT_PTR)producer->context;
+        }
+unpin:
+        if (!--producer->pins && producer->dead) finish_dead_producer(producer);
+        break;
+    default: return STATUS_INVALID_PARAMETER;
+    }
+    params->result = result;
+    return STATUS_SUCCESS;
+}
