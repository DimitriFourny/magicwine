+NTSTATUS WINAPI macdrv_metal_win32_direct(void *arg, ULONG size)
+{
+    struct metal_win32_params *params = arg;
+    const UINT64 *a = params->args;
+    SECURITY_ATTRIBUTES security;
+    HKEY key;
+    UINT64 result;
+    if (size < sizeof(*params)) return STATUS_INVALID_PARAMETER;
+#define PTR(i) ((params->pointer_mask & (1u << (i))) ? (char *)params + a[i] : param_ptr(a[i]))
+    switch (params->slot)
+    {
+    case 10: result = RegQueryValueExA(PTR(0), PTR(1), PTR(2), PTR(3), PTR(4), PTR(5)); break;
+    case 11: result = RegSetValueExA(PTR(0), PTR(1), a[2], a[3], PTR(4), a[5]); break;
+    case 12:
+        result = RegOpenKeyExA(PTR(0), PTR(1), a[2], a[3], a[4] ? &key : NULL);
+        if (!result && a[4]) *(UINT64 *)PTR(4) = (UINT_PTR)key;
+        break;
+    case 13:
+        if (params->pointer_mask & (1u << 6))
+        {
+            security.nLength = sizeof(security);
+            security.bInheritHandle = params->security_inherit;
+            security.lpSecurityDescriptor = params->security_descriptor ? PTR(6) : NULL;
+        }
+        result = RegCreateKeyExA(PTR(0), PTR(1), a[2], PTR(3), a[4], a[5],
+                 (params->pointer_mask & (1u << 6)) ? &security : PTR(6), a[7] ? &key : NULL, PTR(8));
+        if (!result && a[7]) *(UINT64 *)PTR(7) = (UINT_PTR)key;
+        break;
+    case 14: result = RegCloseKey(PTR(0)); break;
+    case 15:
+#ifdef __i386__
+        result = EnumDisplayMonitors(PTR(0), PTR(1), metal_enum_monitor, (LPARAM)params);
+#else
+        result = EnumDisplayMonitors(PTR(0), PTR(1), (MONITORENUMPROC)(UINT_PTR)a[2], a[3]);
+#endif
+        break;
+    case 16: result = GetMonitorInfoA(PTR(0), PTR(1)); break;
+    case 17: result = AdjustWindowRectEx(PTR(0), a[1], a[2], a[3]); break;
+    case 18: result = GetWindowLongPtrW(PTR(0), a[1]); break;
+    case 19: result = GetWindowRect(PTR(0), PTR(1)); break;
+    case 20: result = MoveWindow(PTR(0), a[1], a[2], a[3], a[4], a[5]); break;
+    case 21: result = SetWindowPos(PTR(0), PTR(1), a[2], a[3], a[4], a[5], a[6]); break;
+    case 22: result = GetSystemMetrics(a[0]); break;
+    case 23: result = SetWindowLongPtrW(PTR(0), a[1], a[2]); break;
+    default: return STATUS_INVALID_PARAMETER;
+    }
+#undef PTR
+    params->result = result;
+    return STATUS_SUCCESS;
+}
