+/*
+ * Wine 11 client-surface bridge for D3DMetal and DXMT.
+ * Copyright 2026 MagicWine contributors
+ *
+ * LGPL-2.1-or-later; see COPYING.LIB. ABI reference (LGPL-2.1-or-later):
+ * Whisky-App/wine a92f7f06c4cff7291578e58eb95284b00e322799,
+ * dlls/winemac.drv/macdrv_main.c and macdrv.h.
+ * Original Wine/CodeWeavers copyright notices remain in those source files.
+ */
+#if 0
+#pragma makedep unix
+#endif
+#include "config.h"
+#include <pthread.h>
+#include <limits.h>
+#include <stdlib.h>
+#include "macdrv.h"
+#include "wine/list.h"
+
+/* The published table's Win32 slots and monitor procedure retain WINAPI's
+ * Microsoft x64 ABI. Wine 11 deliberately erases WINAPI in Unix libraries. */
+#define METAL_WINAPI __attribute__((ms_abi))
+typedef BOOL (METAL_WINAPI *metal_monitor_proc)(HMONITOR, HDC, LPRECT, LPARAM);
+
+/* Exact historical 120-byte record, never expose Wine 11's native layout. */
+struct metal_win_data
+{
+    HWND hwnd;
+    macdrv_window cocoa_window;
+    macdrv_view cocoa_view, client_cocoa_view;
+    RECT window_rect, whole_rect, client_rect;
+    int pixel_format;
+    COLORREF color_key;
+    HANDLE drag_event;
+    unsigned int on_screen : 1, shaped : 1, layered : 1, ulw_layered : 1,
+                 per_pixel_alpha : 1, minimized : 1, swap_interval : 1;
+    void *padding[2];
+};
+C_ASSERT(sizeof(struct metal_win_data) == 120);
+C_ASSERT(offsetof(struct metal_win_data, client_cocoa_view) == 24);
+
+struct metal_surface
+{
+    struct list entry;
+    HWND hwnd;
+    struct macdrv_client_surface *surface;
+};
+static pthread_mutex_t metal_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct list metal_surfaces = LIST_INIT(metal_surfaces);
+static UINT64 metal_callback, metal_direct_callback;
+static BOOL metal_wow64;
+
+NTSTATUS macdrv_metal_init(void *arg)
+{
+    metal_callback = ((struct metal_init_params *)arg)->callback;
+    metal_direct_callback = ((struct metal_init_params *)arg)->direct_callback;
+    metal_wow64 = ((struct metal_init_params *)arg)->wow64;
+    return metal_callback && metal_direct_callback ? STATUS_SUCCESS : STATUS_INVALID_PARAMETER;
+}
+
+static void metal_init_display_devices(BOOL force)
+{
+    UINT32 paths, modes;
+    /* Wine 11 owns display enumeration and registry publication in win32u. */
+    if (force) NtUserCallNoParam(NtUserCallNoParam_DisplayModeChanged);
+    NtUserGetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &paths, &modes);
+}
+
+static struct metal_win_data *metal_get_win_data(HWND hwnd)
+{
+    struct metal_win_data *copy;
+    struct metal_surface *owned;
+    struct macdrv_win_data *data;
+    if (!(copy = calloc(1, sizeof(*copy)))) return NULL;
+    if (!(owned = calloc(1, sizeof(*owned)))) { free(copy); return NULL; }
+    /* Surface creation enters win32u; do it before taking the window lock. */
+    if (!(owned->surface = macdrv_client_surface_create(hwnd))) goto failed;
+    if (!(data = get_win_data(hwnd)))
+    {
+        client_surface_release(&owned->surface->client);
+        goto failed;
+    }
+    copy->hwnd = hwnd;
+    copy->cocoa_window = data->cocoa_window;
+    copy->client_cocoa_view = owned->surface->cocoa_view;
+    copy->window_rect = data->rects.window;
+    copy->whole_rect = data->rects.visible;
+    copy->client_rect = data->rects.client;
+    copy->pixel_format = data->pixel_format;
+    copy->color_key = CLR_INVALID;
+    copy->drag_event = data->drag_event;
+    copy->on_screen = data->on_screen;
+    copy->shaped = data->shaped;
+    copy->layered = data->layered;
+    copy->ulw_layered = data->ulw_layered;
+    copy->per_pixel_alpha = data->per_pixel_alpha;
+    copy->minimized = data->minimized;
+    owned->hwnd = hwnd;
+    pthread_mutex_lock(&metal_mutex);
+    list_add_tail(&metal_surfaces, &owned->entry);
+    pthread_mutex_unlock(&metal_mutex);
+    release_win_data(data);
+    return copy;
+failed:
+    free(owned);
+    free(copy);
+    return NULL;
+}
+
+static macdrv_metal_view metal_create_view(macdrv_view view, macdrv_metal_device device)
+{
+    struct metal_surface *owned;
+    struct macdrv_client_surface *surface = NULL;
+    macdrv_metal_view result;
+    pthread_mutex_lock(&metal_mutex);
+    LIST_FOR_EACH_ENTRY(owned, &metal_surfaces, struct metal_surface, entry)
+        if (owned->surface->cocoa_view == view)
+        {
+            surface = owned->surface;
+            client_surface_add_ref(&surface->client);
+            break;
+        }
+    pthread_mutex_unlock(&metal_mutex);
+    if (!surface) return NULL;
+    surface->metal_view = macdrv_view_create_metal_view(view, device);
+    result = surface->metal_view;
+    if (result) macdrv_metal_watch_view(result);
+    client_surface_release(&surface->client);
+    return result;
+}
+
+static void metal_release_win_data(struct metal_win_data *data)
+{
+    free(data);
+}
+
+static void metal_release_view(macdrv_metal_view view)
+{
+    struct metal_surface *owned, *found = NULL;
+    pthread_mutex_lock(&metal_mutex);
+    LIST_FOR_EACH_ENTRY(owned, &metal_surfaces, struct metal_surface, entry)
+        if (owned->surface->metal_view == view)
+        {
+            list_remove(&owned->entry);
+            found = owned;
+            break;
+        }
+    pthread_mutex_unlock(&metal_mutex);
+    if (!found) return;
+    client_surface_release(&found->surface->client);
+    free(found);
+}
+
+/* D3DMetal 3 does not call release_view on swapchain destruction. Retain its
+ * surface until HWND destruction; DXMT can release it earlier through slot 8. */
+void macdrv_metal_destroy_window(HWND hwnd)
+{
+    struct metal_surface *owned, *next;
+    struct list removed = LIST_INIT(removed);
+    pthread_mutex_lock(&metal_mutex);
+    LIST_FOR_EACH_ENTRY_SAFE(owned, next, &metal_surfaces, struct metal_surface, entry)
+        if (owned->hwnd == hwnd)
+        {
+            list_remove(&owned->entry);
+            list_add_tail(&removed, &owned->entry);
+        }
+    pthread_mutex_unlock(&metal_mutex);
+    LIST_FOR_EACH_ENTRY_SAFE(owned, next, &removed, struct metal_surface, entry)
+    {
+        list_remove(&owned->entry);
+        client_surface_release(&owned->surface->client);
+        free(owned);
+    }
+}
+
+void macdrv_metal_present_view(macdrv_view view)
+{
+    struct metal_surface *owned;
+    struct client_surface *surface = NULL;
+    pthread_mutex_lock(&metal_mutex);
+    LIST_FOR_EACH_ENTRY(owned, &metal_surfaces, struct metal_surface, entry)
+        if (owned->surface->cocoa_view == view)
+        {
+            surface = &owned->surface->client;
+            client_surface_add_ref(surface);
+            break;
+        }
+    pthread_mutex_unlock(&metal_mutex);
+    if (!surface) return;
+    client_surface_present(surface);
+    client_surface_release(surface);
+}
+
+NTSTATUS macdrv_metal_enum(void *arg)
+{
+    struct metal_enum_params *params = arg;
+    metal_monitor_proc callback = (metal_monitor_proc)(UINT_PTR)params->callback;
+    params->result = callback((HMONITOR)(UINT_PTR)params->monitor, (HDC)(UINT_PTR)params->dc,
+                             &params->rect, params->lparam);
+    return STATUS_SUCCESS;
+}
+
+struct metal_buffer
+{
+    void *data;
+    SIZE_T size, offset;
+    BOOL output;
+};
+
+static void metal_add_buffer(struct metal_win32_params *params, struct metal_buffer *buffers,
+                             UINT *count, SIZE_T *size, int arg, const void *data,
+                             SIZE_T length, BOOL output)
+{
+    struct metal_buffer *buffer;
+    if (!data) return;
+    if (arg >= 0 && !(params->slot == 13 && arg == 6) &&
+        (UINT_PTR)data <= UINT_MAX && length <= UINT_MAX - (UINT_PTR)data) return;
+    buffer = &buffers[(*count)++];
+    buffer->data = (void *)data;
+    buffer->size = length;
+    buffer->offset = *size;
+    buffer->output = output;
+    if (arg >= 0)
+    {
+        params->args[arg] = *size;
+        params->pointer_mask |= 1u << arg;
+    }
+    *size += (length + 7) & ~(SIZE_T)7;
+}
+
+/* KeUserDispatchCallback copies this packet onto the PE stack. Relative offsets
+ * keep native strings/output buffers addressable in PE32 without allocating a
+ * separate low-address heap or truncating native pointers. PE64 needs no copies. */
+static struct metal_win32_params *metal_pack_wow64(struct metal_win32_params *params,
+                                                  struct metal_buffer *buffers, UINT *count, SIZE_T *size)
+{
+    const UINT64 *a = params->args;
+    UINT64 original[9];
+    SECURITY_DESCRIPTOR_RELATIVE relative = {0};
+    const char empty = 0;
+    struct metal_win32_params *packed;
+    UINT i;
+    memcpy(original, a, sizeof(original));
+    a = original;
+#define PTR(i) ((void *)(UINT_PTR)a[i])
+#define BUFFER(i, n, out) do { if (a[i]) metal_add_buffer(params, buffers, count, size, i, PTR(i), n, out); } while (0)
+#define STRING(i) BUFFER(i, a[i] ? strlen(PTR(i)) + 1 : 0, FALSE)
+    switch (params->slot)
+    {
+    case 10:
+        STRING(1);
+        BUFFER(2, sizeof(DWORD), TRUE);
+        BUFFER(3, sizeof(DWORD), TRUE);
+        BUFFER(4, a[5] ? *(DWORD *)PTR(5) : 0, TRUE);
+        BUFFER(5, sizeof(DWORD), TRUE);
+        break;
+    case 11: STRING(1); BUFFER(4, (DWORD)a[5], FALSE); break;
+    case 12: STRING(1); BUFFER(4, sizeof(UINT64), TRUE); break;
+    case 13:
+        STRING(1);
+        STRING(3);
+        if (a[6])
+        {
+            const SECURITY_ATTRIBUTES *security = PTR(6);
+            const SECURITY_DESCRIPTOR *sd = security->lpSecurityDescriptor;
+            params->security_inherit = security->bInheritHandle;
+            params->security_descriptor = !!sd;
+            if (sd)
+            {
+                const void *parts[4];
+                ULONG *offsets = &relative.Owner;
+                SIZE_T base = *size;
+                relative.Revision = sd->Revision;
+                relative.Sbz1 = sd->Sbz1;
+                relative.Control = sd->Control | SE_SELF_RELATIVE;
+                if (sd->Control & SE_SELF_RELATIVE)
+                {
+                    const SECURITY_DESCRIPTOR_RELATIVE *source = (const void *)sd;
+                    const ULONG *fields = &source->Owner;
+                    for (i = 0; i < 4; ++i) parts[i] = fields[i] ? (const char *)sd + fields[i] : NULL;
+                }
+                else
+                {
+                    parts[0] = sd->Owner; parts[1] = sd->Group;
+                    parts[2] = sd->Sacl; parts[3] = sd->Dacl;
+                }
+                metal_add_buffer(params, buffers, count, size, 6, &relative, sizeof(relative), FALSE);
+                for (i = 0; i < 4; ++i) if (parts[i])
+                {
+                    SIZE_T length = i < 2 ? 8 + 4 * ((const SID *)parts[i])->SubAuthorityCount :
+                                           ((const ACL *)parts[i])->AclSize;
+                    offsets[i] = *size - base;
+                    metal_add_buffer(params, buffers, count, size, -1, parts[i], length, FALSE);
+                }
+            }
+            else metal_add_buffer(params, buffers, count, size, 6, &empty, 1, FALSE);
+        }
+        BUFFER(7, sizeof(UINT64), TRUE);
+        BUFFER(8, sizeof(DWORD), TRUE);
+        break;
+    case 15: BUFFER(1, sizeof(RECT), FALSE); break;
+    case 16:
+        if (a[1])
+        {
+            DWORD length = ((MONITORINFO *)PTR(1))->cbSize;
+            if (length != sizeof(MONITORINFO) && length != sizeof(MONITORINFOEXA)) length = sizeof(DWORD);
+            BUFFER(1, length, TRUE);
+        }
+        break;
+    case 17: BUFFER(0, sizeof(RECT), TRUE); break;
+    case 19: BUFFER(1, sizeof(RECT), TRUE); break;
+    }
+#undef STRING
+#undef BUFFER
+#undef PTR
+    if (!*count) return params;
+    if (*size > UINT_MAX || !(packed = calloc(1, *size))) return NULL;
+    memcpy(packed, params, sizeof(*params));
+    for (i = 0; i < *count; ++i)
+        memcpy((char *)packed + buffers[i].offset, buffers[i].data, buffers[i].size);
+    return packed;
+}
+
+/* Apple can enter on the Windows user stack, while DXMT enters through Wine's
+ * Unix dispatcher on its kernel stack. Only the latter needs a kernel-to-user
+ * callback; attempting one on the user stack would report stack overflow.
+ * Return buffers are consumed before another transition can overwrite them. */
+static UINT64 metal_win32_call(UINT slot, const UINT64 *args, UINT count)
+{
+    struct metal_win32_params params = {.dispatch = {.callback = metal_callback}, .slot = slot};
+    struct metal_win32_params *packed = &params, *result;
+    struct metal_buffer buffers[12];
+    UINT buffers_count = 0, i;
+    SIZE_T packed_size = sizeof(params);
+    ULONG size;
+    NTSTATUS status;
+    UINT64 value;
+    TEB *teb = NtCurrentTeb();
+    memcpy(params.args, args, count * sizeof(*args));
+    if (!metal_wow64 && (ULONG_PTR)&params >= (ULONG_PTR)teb->Tib.StackLimit &&
+        (ULONG_PTR)&params < (ULONG_PTR)teb->Tib.StackBase)
+    {
+        NTSTATUS (METAL_WINAPI *call)(void *, ULONG) = (void *)(UINT_PTR)metal_direct_callback;
+        status = call(&params, sizeof(params));
+        result = &params;
+        size = sizeof(params);
+    }
+    else
+    {
+        if (metal_wow64 && !(packed = metal_pack_wow64(&params, buffers, &buffers_count, &packed_size)))
+        {
+            RtlSetLastWin32Error(ERROR_NOT_ENOUGH_MEMORY);
+            return slot <= 14 ? ERROR_NOT_ENOUGH_MEMORY : 0;
+        }
+        status = KeUserDispatchCallback(&packed->dispatch, packed_size, (void **)&result, &size);
+        if (packed != &params) free(packed);
+    }
