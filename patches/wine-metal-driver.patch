+/* CodeWeavers CW HACK 22434 / CX Hack 23015, using the selected runtime view
+ * rather than a process-global graphics backend or library-path environment. */
+__attribute__((visibility("default"))) const unsigned int magicwine_metal_ntdll_v1 = 1;
+
+#if defined(__APPLE__) && defined(__x86_64__)
+static pthread_once_t d3dmetal_non_native_once = PTHREAD_ONCE_INIT;
+static void *d3dmetal_non_native_lib;
+void *libd3dshared_load_addr, *libd3dshared_code_end;
+static void (*register_non_native_code_region)( void *, void * );
+static bool (*supports_non_native_code_regions)(void);
+
+static char *resolve_libd3dshared_path(void)
+{
+    static const char * const aliases[] = { "d3d11.so", "d3d12.so", "dxgi.so" };
+    char resolved[PATH_MAX], *path;
+    unsigned int i;
+
+    /* GraphicsRuntimeView links these aliases to the one canonical
+     * external/libd3dshared.dylib. Standard and DXMT views do not. Do not
+     * search other runtimes or load their graphics libraries incidentally. */
+    for (i = 0; i < ARRAY_SIZE(aliases); i++)
+    {
+        path = build_path( ntdll_dir, aliases[i] );
+        if (realpath( path, resolved ))
+        {
+            const char *name = strrchr( resolved, '/' );
+            if (name && !strcmp( name + 1, "libd3dshared.dylib" ))
+            {
+                free( path );
+                return strdup( resolved );
+            }
+        }
+        free( path );
+    }
+    return NULL;
+}
+
+static void init_d3dmetal_non_native_support(void)
+{
+    char resolved[PATH_MAX], *path = resolve_libd3dshared_path();
+    unsigned int i;
+
+    if (!path) return;
+    if (!(d3dmetal_non_native_lib = dlopen( path, RTLD_NOW | RTLD_LOCAL )))
+    {
+        WARN( "failed to load %s: %s\n", debugstr_a(path), dlerror() );
+        free( path );
+        return;
+    }
+
+    /* The ABI discriminator must also work when the optional code-region
+     * APIs are absent. Find the actual loaded image, not an API's address. */
+    for (i = 0; i < _dyld_image_count(); i++)
+    {
+        const struct mach_header_64 *header;
+        const char *name = _dyld_get_image_name( i );
+        unsigned long size = 0;
+        void *text;
+
+        if (!name || !realpath( name, resolved ) || strcmp( path, resolved )) continue;
+        header = (const struct mach_header_64 *)_dyld_get_image_header( i );
+        if ((text = getsegmentdata( header, "__TEXT", &size )) && size)
+        {
+            libd3dshared_code_end = (char *)text + size;
+            libd3dshared_load_addr = text;
+        }
+        break;
+    }
+
+    if (__builtin_available( macOS 14.0, * ))
+    {
+        register_non_native_code_region = dlsym( d3dmetal_non_native_lib, "register_non_native_code_region" );
+        supports_non_native_code_regions = dlsym( d3dmetal_non_native_lib, "supports_non_native_code_regions" );
+    }
+    TRACE( "loaded %s, code %p-%p\n", debugstr_a(path),
+           libd3dshared_load_addr, libd3dshared_code_end );
