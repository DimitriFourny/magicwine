+/* In WoW64 the caller's monitor procedure is native 64-bit code. Enter it
+ * through Wine's Unix transition, never truncate it to a PE32 code pointer. */
+#ifdef __i386__
+static BOOL CALLBACK metal_enum_monitor(HMONITOR monitor, HDC dc, LPRECT rect, LPARAM context)
+{
+    const struct metal_win32_params *call = (void *)context;
+    struct metal_enum_params params = {.callback = call->args[2], .monitor = (UINT_PTR)monitor,
+        .dc = (UINT_PTR)dc, .lparam = call->args[3], .rect = *rect};
+    if (MACDRV_CALL(metal_enum, &params)) return FALSE;
+    return params.result;
+}
+#endif
