<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plural forms for counted phrases built with `localized(_:)`. The key is the English text with
     %lld for the count (see Localizable.strings); each translation lists the plural categories
     its language needs (zero, one, two, few, many, other). -->
<plist version="1.0">
<dict>
    <key>%lld items</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld item</string>
            <key>other</key><string>%lld items</string>
        </dict>
    </dict>
    <key>%lld controllers connected</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld controller connected</string>
            <key>other</key><string>%lld controllers connected</string>
        </dict>
    </dict>
    <key>%lld logs, newest first</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld log, newest first</string>
            <key>other</key><string>%lld logs, newest first</string>
        </dict>
    </dict>
    <key>Passed as %lld arguments:</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>Passed as %lld argument:</string>
            <key>other</key><string>Passed as %lld arguments:</string>
        </dict>
    </dict>
    <key>Remove %lld Unused Items?</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>Remove %lld Unused Item?</string>
            <key>other</key><string>Remove %lld Unused Items?</string>
        </dict>
    </dict>
    <key>%lld items were kept because they are in use again or already gone.</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld item was kept because it is in use again or already gone.</string>
            <key>other</key><string>%lld items were kept because they are in use again or already gone.</string>
        </dict>
    </dict>
    <key>Removed %lld of %lld items (%@).</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>Removed %1$lld of %2$#@total@ (%3$@).</string>
        <key>total</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld item</string>
            <key>other</key><string>%lld items</string>
        </dict>
    </dict>
    <key>%lld programs in %lld bottles</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$#@programs@ in %2$#@bottles@</string>
        <key>programs</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld program</string>
            <key>other</key><string>%lld programs</string>
        </dict>
        <key>bottles</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld bottle</string>
            <key>other</key><string>%lld bottles</string>
        </dict>
    </dict>
</dict>
</plist>
